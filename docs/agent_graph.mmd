---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	plan(plan)
	ingest(ingest)
	reconcile(reconcile)
	extract(extract)
	validate(validate)
	report(report)
	answer(answer)
	retrieve(retrieve)
	__end__([<p>__end__</p>]):::last
	__start__ --> plan;
	extract --> validate;
	ingest --> reconcile;
	plan -.-> answer;
	plan -.-> ingest;
	reconcile -.-> retrieve;
	reconcile -.-> validate;
	retrieve -.-> extract;
	validate -.-> report;
	validate -.-> retrieve;
	answer --> __end__;
	report --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc

