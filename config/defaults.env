# Default model names. Read before .env, so any line in .env (or an environment variable)
# overrides these. Keeping them here, not in code, means every model choice is configuration.

# LLM provider and models (see .env.example for other providers and their model names).
RFP_LLM_PROVIDER=anthropic
RFP_EXTRACT_MODEL=claude-opus-5-5
RFP_CHEAP_MODEL=claude-haiku-5-5

# Retrieval models, run locally on CPU through fastembed. See docs/eval/retrieval.md.
RFP_EMBED_MODEL=BAAI/bge-small-en-v1.5
RFP_SPARSE_MODEL=Qdrant/bm25
RFP_RERANK_MODEL=BAAI/bge-reranker-v2-m3-int8
