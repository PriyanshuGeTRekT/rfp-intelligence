# Copy to .env. Every setting can also be passed as an environment variable.

# LLM provider: name it, give its key, pick its models. Check with `uv run rfp llm-check`.
# Known names fill in the base URL and read the provider's usual key variable:
#   anthropic / claude  ANTHROPIC_API_KEY     claude-opus-5-5, claude-haiku-5-5 (Anthropic SDK)
#   openai              OPENAI_API_KEY        e.g. gpt-5, gpt-5-mini
#   groq                GROQ_API_KEY          e.g. llama-3.3-70b-versatile
#   xai / grok          XAI_API_KEY           e.g. grok-4
#   gemini / google     GEMINI_API_KEY        e.g. gemini-2.5-pro, gemini-2.5-flash
#   mistral             MISTRAL_API_KEY       e.g. mistral-large-latest
#   together            TOGETHER_API_KEY      openrouter  OPENROUTER_API_KEY   deepseek  DEEPSEEK_API_KEY
#   ollama / lmstudio / vllm   local servers, no key, e.g. llama3.1:70b
#   azure               AZURE_OPENAI_API_KEY  plus RFP_LLM_BASE_URL=https://<resource>.openai.azure.com/openai/deployments/<deployment>
#                                             and RFP_LLM_EXTRA_QUERY={"api-version":"2024-10-21"}
# Any other OpenAI-compatible service: any name plus RFP_LLM_BASE_URL and RFP_LLM_API_KEY.
RFP_LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# RFP_LLM_API_KEY=          # overrides the provider's own key variable
# RFP_LLM_BASE_URL=         # overrides the preset's base URL
# RFP_LLM_AUTH_STYLE=       # bearer (default) or api-key
# RFP_LLM_EXTRA_QUERY={}
# RFP_LLM_SEND_REASONING_EFFORT=false   # only for servers that accept reasoning_effort
# Cost tracking for models the built-in price table does not know (USD per million tokens):
# RFP_LLM_PRICE_INPUT_PER_M=
# RFP_LLM_PRICE_OUTPUT_PER_M=

# Paths (relative to the repo root)
RFP_DATA_DIR=data/bids
RFP_STATE_DIR=var
RFP_TRACES_DIR=traces

# Models
RFP_EXTRACT_MODEL=claude-opus-5-5
RFP_CHEAP_MODEL=claude-haiku-5-5
RFP_EMBED_MODEL=BAAI/bge-small-en-v1.5
RFP_SPARSE_MODEL=Qdrant/bm25
RFP_RERANK_MODEL=BAAI/bge-reranker-v2-m3-int8
# RFP_MODEL_CACHE_DIR=~/.cache/rfp-intel/models

# Vector store: embedded under RFP_STATE_DIR/qdrant unless a server URL is set
RFP_QDRANT_URL=
RFP_QDRANT_COLLECTION=chunks

# API: when set, every endpoint except /health requires the X-API-Key header
RFP_API_KEY=
RFP_MAX_REQUEST_BYTES=65536

# Tracing: spans always go to traces/<run_id>.jsonl; set an OTLP endpoint to also
# send them to Phoenix (http://localhost:6006/v1/traces) or Langfuse. Needs the `obs` extra.
OTEL_EXPORTER_OTLP_ENDPOINT=
RFP_TRACE_REDACT_PII=true
RFP_LOG_LEVEL=INFO
