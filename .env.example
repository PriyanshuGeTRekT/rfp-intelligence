# Copy to .env. Every setting can also be passed as an environment variable.

# LLM provider. Default: Claude through the Anthropic SDK.
RFP_LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Any OpenAI-compatible chat API instead (OpenAI, Azure OpenAI, Groq, Mistral, Together,
# OpenRouter, Ollama, vLLM, ...): set the provider, the base URL, the key and model names.
#   OpenAI:   RFP_LLM_BASE_URL=https://api.openai.com/v1            RFP_EXTRACT_MODEL=gpt-5-mini
#   Groq:     RFP_LLM_BASE_URL=https://api.groq.com/openai/v1       RFP_EXTRACT_MODEL=llama-3.3-70b-versatile
#   Ollama:   RFP_LLM_BASE_URL=http://localhost:11434/v1            RFP_EXTRACT_MODEL=llama3.1:70b   (no key)
#   Azure:    RFP_LLM_BASE_URL=https://<resource>.openai.azure.com/openai/deployments/<deployment>
#             RFP_LLM_AUTH_STYLE=api-key   RFP_LLM_EXTRA_QUERY={"api-version":"2024-10-21"}
# RFP_LLM_PROVIDER=openai
# RFP_LLM_BASE_URL=https://api.openai.com/v1
# RFP_LLM_API_KEY=
# RFP_LLM_AUTH_STYLE=bearer
# RFP_LLM_EXTRA_QUERY={}
# RFP_LLM_SEND_REASONING_EFFORT=false
# Cost tracking for models the built-in price table does not know (USD per million tokens):
# RFP_LLM_PRICE_INPUT_PER_M=
# RFP_LLM_PRICE_OUTPUT_PER_M=

# Paths (relative to the repo root)
RFP_DATA_DIR=data/bids
RFP_STATE_DIR=var
RFP_TRACES_DIR=traces

# Models
RFP_EXTRACT_MODEL=claude-opus-5-5
RFP_CHEAP_MODEL=claude-haiku-5-5
RFP_EMBED_MODEL=BAAI/bge-small-en-v1.5
RFP_SPARSE_MODEL=Qdrant/bm25
RFP_RERANK_MODEL=BAAI/bge-reranker-v2-m3-int8
# RFP_MODEL_CACHE_DIR=~/.cache/rfp-intel/models

# Vector store: embedded under RFP_STATE_DIR/qdrant unless a server URL is set
RFP_QDRANT_URL=
RFP_QDRANT_COLLECTION=chunks

# API: when set, every endpoint except /health requires the X-API-Key header
RFP_API_KEY=
RFP_MAX_REQUEST_BYTES=65536

# Tracing: spans always go to traces/<run_id>.jsonl; set an OTLP endpoint to also
# send them to Phoenix (http://localhost:6006/v1/traces) or Langfuse. Needs the `obs` extra.
OTEL_EXPORTER_OTLP_ENDPOINT=
RFP_TRACE_REDACT_PII=true
RFP_LOG_LEVEL=INFO
